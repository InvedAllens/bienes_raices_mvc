# Copia este archivo como .env y completa tus datos (el .env NO se sube a GitHub)
# Puede guardarse en la raiz del proyecto o, mejor en un hosting, UNA CARPETA ARRIBA
# (fuera de la zona publica). Si el valor tiene espacios, # o $, ponlo entre comillas dobles.

# --- Ruta base ---
# Dejala vacia si la app vive en la raiz de un dominio (https://sitio.com). Si comparte dominio con otra
# app y vive en una ruta (https://sitio.com/bienes-raices) escribe esa ruta: APP_BASE_PATH=/bienes-raices
APP_BASE_PATH=

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bienesraices
DB_PASS=cambia_esta_clave
DB_BD=bienesraices

# --- Correo del formulario de contacto (SMTP) ---
# Si MAIL_HOST se deja vacio los mensajes NO se envian: el contenido se escribe en el
# log de errores de PHP (util para desarrollar sin configurar un servidor de correo).
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=tls
# remitente (con alwaysdata debe ser la misma direccion del buzon MAIL_USER)
MAIL_FROM=contacto@bienesraices.com
# direccion que RECIBE los mensajes del formulario de contacto
CONTACTO_EMAIL=contacto@bienesraices.com

# true muestra el detalle de errores de conexion (solo en desarrollo)
APP_DEBUG=false
